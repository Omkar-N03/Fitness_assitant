<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material Design 3 Dark -->
    <style name="Theme.FitnessAssistant" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/surface_border</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/surface_item</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="Theme.MyApplication" parent="Theme.FitnessAssistant" />

    <!-- Elegant Dark Card Styles -->
    <style name="Widget.FitnessAssistant.Card.Hero" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="strokeColor">@color/surface_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <style name="Widget.FitnessAssistant.Card.Secondary" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/surface_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.FitnessAssistant.Card.Item" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_item</item>
        <item name="strokeColor">@color/surface_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
    </style>

    <!-- Bottom Navigation Bar Style -->
    <style name="Widget.FitnessAssistant.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_item</item>
        <item name="itemIconTint">@color/nav_item_color_state</item>
        <item name="itemTextColor">@color/nav_item_color_state</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.FitnessAssistant.BottomNav.ActiveIndicator</item>
    </style>

    <style name="Widget.FitnessAssistant.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_active_pill</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FitnessAssistant.Pill</item>
    </style>

    <style name="ShapeAppearance.FitnessAssistant.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.FitnessAssistant.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/fab_bg</item>
        <item name="tint">@color/fab_icon</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FitnessAssistant.Fab</item>
        <item name="elevation">6dp</item>
    </style>

    <style name="ShapeAppearance.FitnessAssistant.Fab" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
</resources>
