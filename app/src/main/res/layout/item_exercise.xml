<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FitnessAssistant.Card.Item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Exercise Title -->
        <TextView
            android:id="@+id/tvExerciseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Barbell Bench Press"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chipLevel"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Difficulty Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipLevel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:clickable="false"
            app:chipCornerRadius="12dp"
            app:chipStrokeWidth="0dp"
            tools:text="Intermediate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvExerciseTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvExerciseTitle" />

        <!-- Body Part and Equipment Row -->
        <LinearLayout
            android:id="@+id/metaRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivPlayVideo"
            app:layout_constraintTop_toBottomOf="@id/tvExerciseTitle">

            <!-- Body Part Pill -->
            <TextView
                android:id="@+id/tvBodyPart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Chest" />

            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <!-- Equipment Pill -->
            <TextView
                android:id="@+id/tvEquipment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_neutral_badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Barbell" />
        </LinearLayout>

        <!-- Video Play Icon Indicator -->
        <ImageView
            android:id="@+id/ivPlayVideo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="YouTube Video"
            android:src="@drawable/ic_play_arrow"
            app:tint="@color/primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/metaRow"
            app:layout_constraintTop_toTopOf="@id/metaRow" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
