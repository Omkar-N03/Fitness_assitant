<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FitnessAssistant.Card.Secondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Split Name & Icon Header -->
        <ImageView
            android:id="@+id/ivSplitIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_fitness_center"
            android:contentDescription="Workout Split"
            app:tint="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSplitName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Push Day Split"
            app:layout_constraintStart_toEndOf="@id/ivSplitIcon"
            app:layout_constraintEnd_toStartOf="@id/tvExercisesCount"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Exercises Count Badge -->
        <TextView
            android:id="@+id/tvExercisesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_badge_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="3 Exercises"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Date Row -->
        <ImageView
            android:id="@+id/ivCalendar"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_calendar"
            android:contentDescription="Workout Date"
            app:tint="@color/text_secondary"
            app:layout_constraintStart_toStartOf="@id/tvSplitName"
            app:layout_constraintTop_toBottomOf="@id/tvSplitName" />

        <TextView
            android:id="@+id/tvSummaryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Today, Sep 11"
            app:layout_constraintStart_toEndOf="@id/ivCalendar"
            app:layout_constraintTop_toTopOf="@id/ivCalendar"
            app:layout_constraintBottom_toBottomOf="@id/ivCalendar" />

        <!-- Divider -->
        <View
            android:id="@+id/dividerSummary"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/surface_border"
            app:layout_constraintTop_toBottomOf="@id/tvSummaryDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Exercises Included Section -->
        <TextView
            android:id="@+id/tvExercisesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Exercises Performed:"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/dividerSummary"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvExercisesList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="• Barbell Bench Press\n• Incline Dumbbell Press\n• Tricep Pushdown"
            app:layout_constraintTop_toBottomOf="@id/tvExercisesLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Optional Notes -->
        <TextView
            android:id="@+id/tvSummaryNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Notes: Great mind-muscle connection"
            tools:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/tvExercisesList"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Actions Row: Edit Split & Delete Session -->
        <LinearLayout
            android:id="@+id/llSplitActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvSummaryNotes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditSplit"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Edit Split"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_edit"
                app:iconSize="16dp"
                app:iconTint="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteSplit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Delete Permanent"
                android:textColor="@color/bmi_obese_color"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_delete"
                app:iconSize="16dp"
                app:iconTint="@color/bmi_obese_color"
                app:strokeColor="@color/bmi_obese_color" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
